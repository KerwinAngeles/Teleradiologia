# Variables de entorno de producción (docker-compose.prod.yml).
#
# Este archivo es una PLANTILLA — no lleva valores reales y sí se versiona.
# En Coolify van cargadas en la pestaña "Environment Variables" del recurso, no en un archivo.
# Si probás el stack de producción localmente, copialo a .env (que está en .gitignore).
#
# Las que no tienen valor por defecto en el compose hacen fallar el arranque si faltan.

# --- Base de datos -----------------------------------------------------------------
POSTGRES_DB=teleradiologia
POSTGRES_USER=teleradiologia
# openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Orthanc (mini-PACS) -----------------------------------------------------------
ORTHANC_NAME=Teleradiologia
ORTHANC_USERNAME=teleradiologia
# openssl rand -base64 24
ORTHANC_PASSWORD=

# --- Autenticación (GoTrue / Supabase self-hosted) ---------------------------------
# openssl rand -base64 24
SUPABASE_DB_PASSWORD=

# Con este secreto GoTrue firma los tokens y la API los valida. Mínimo 32 bytes o la API se
# niega a arrancar. Cualquiera que lo tenga se firma un token de Admin: no lo reutilices entre
# ambientes ni lo pongas en el repo.
#   openssl rand -base64 48
SUPABASE_JWT_SECRET=

# JWT con role=service_role FIRMADO CON EL SECRETO DE ARRIBA. Es la credencial de superusuario
# de GoTrue: la API la usa para dar de alta y borrar cuentas. Si cambiás SUPABASE_JWT_SECRET,
# hay que regenerar esta clave o el alta de usuarios falla con 401.
#
# Generarla (en cualquier máquina con bash, openssl y el secreto en $SUPABASE_JWT_SECRET):
#
#   b64() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
#   h=$(printf '%s' '{"alg":"HS256","typ":"JWT"}' | b64)
#   p=$(printf '%s' "{\"iss\":\"supabase\",\"role\":\"service_role\",\"iat\":$(date +%s),\"exp\":$(($(date +%s)+315360000))}" | b64)
#   s=$(printf '%s' "$h.$p" | openssl dgst -sha256 -hmac "$SUPABASE_JWT_SECRET" -binary | b64)
#   echo "$h.$p.$s"
SUPABASE_SERVICE_ROLE_KEY=

# --- Firma digital de informes -----------------------------------------------------
# Clave privada RSA en PEM (PKCS#8) con la que se firman los informes. En Production la API
# NO arranca sin ella. Es el valor más delicado del stack: si la cambiás, todos los informes
# firmados antes dejan de verificar. Respaldala fuera del servidor.
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
#
# Es multilínea. En Coolify, marcá la variable como "Multiline" y pegá el PEM entero, incluidas
# las líneas BEGIN/END PRIVATE KEY.
FIRMA_CLAVE_PRIVADA_PEM=

# --- Email -------------------------------------------------------------------------
# 465 (TLS directo), NO 587: SmtpEmailSender no implementa STARTTLS. Ver README.
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Teleradiologia

# --- App ---------------------------------------------------------------------------
# Dominio público, con esquema y sin barra final. Lo usan CORS y los enlaces de los emails
# que manda GoTrue (recuperación de contraseña).
APP_URL=https://teleradiologia.tu-dominio.com

# --- Imágenes --------------------------------------------------------------------
# Solo si construís en CI y Coolify baja las imágenes en vez de compilarlas en la VPS.
# Tiene que ir TODO EN MINÚSCULAS: GHCR rechaza mayúsculas en el nombre de la imagen.
# IMAGE_PREFIX=ghcr.io/kerwinangeles/teleradiologia
# IMAGE_TAG=latest
